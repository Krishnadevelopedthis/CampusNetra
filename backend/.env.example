# ---------- Application ----------
APP_NAME="Campus Netra"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---------- Database ----------
# Local dev default matches scripts/dev_db.sh (port 55432, no password needed)
DATABASE_URL=postgresql+asyncpg://campusnetra:campusnetra@localhost:55432/campusnetra

# ---------- Security ----------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production-use-a-64-byte-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
OTP_EXPIRE_MINUTES=10
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ---------- AI ----------
# Leave blank to run on the deterministic heuristic fallback (no API calls, still works).
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_ENABLED=true

# ---------- Storage ----------
# 'local' writes to ./uploads and serves them from /media
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ---------- Email (OTP / password reset) ----------
# When SMTP_HOST is blank, emails are printed to the console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Campus Netra <no-reply@campusnetra.app>"
