# ---------- Application ----------
APP_NAME="Campus Netra"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---------- Database ----------
# Local dev default matches scripts/dev_db.sh (port 55432, no password needed)
DATABASE_URL=postgresql+asyncpg://neondb_owner:----

# ---------- Security ----------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production-use-a-64-byte-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
OTP_EXPIRE_MINUTES=10
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ---------- AI ----------
# Leave blank to run on the deterministic heuristic fallback (no API calls, still works).
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_ENABLED=true

# ---------- Storage ----------
# 'local' writes to ./uploads and serves them from /media. Fine for local
# dev; on most PaaS hosts (Render included) the disk is wiped on every
# redeploy or restart, silently deleting every photo. Use 'local' only if
# your host gives you a persistent volume. Set 's3' to point at any
# S3-compatible bucket instead — AWS S3, Cloudflare R2, Backblaze B2, and
# DigitalOcean Spaces all work; R2 and B2 both have workable free tiers.
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Only used when STORAGE_BACKEND=s3. Leave all blank for local storage.
# S3_BUCKET / S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY are required once s3
# is selected — the app refuses to start without them.
S3_BUCKET=
# AWS: your bucket's region, e.g. us-east-1. R2/B2/Spaces: leave "auto" or
# check the provider's docs.
S3_REGION=auto
# Leave blank for plain AWS S3. Required for R2/B2/Spaces, e.g.:
#   Cloudflare R2:      https://<account-id>.r2.cloudflarestorage.com
#   Backblaze B2:        https://s3.<region>.backblazeb2.com
#   DigitalOcean Spaces:  https://<region>.digitaloceanspaces.com
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Where uploaded photos are served from publicly. Leave blank to fall back
# to a default the bucket will answer directly (works, but a CDN/custom
# domain in front of the bucket is faster) — e.g.:
#   Plain AWS S3 default: https://<bucket>.s3.<region>.amazonaws.com
#   Behind a CDN/custom domain: https://media.yourcampus.edu
S3_PUBLIC_BASE_URL=
#
# Objects are written with no per-object ACL (buckets created on AWS since
# April 2023 have ACLs disabled by default, and several S3-compatible
# providers never supported them). Public read access for uploaded photos
# comes from a bucket policy instead — apply one covering only the
# "public/" prefix, e.g. for AWS S3:
#   {
#     "Version": "2012-10-17",
#     "Statement": [{
#       "Sid": "PublicReadUploads",
#       "Effect": "Allow",
#       "Principal": "*",
#       "Action": "s3:GetObject",
#       "Resource": "arn:aws:s3:::YOUR_BUCKET_NAME/public/*"
#     }]
#   }
# The "private/" prefix (ID cards, etc.) is never covered by this policy —
# it's only ever read through the backend's authenticated routes.

# ---------- Email (OTP / password reset) ----------
# When SMTP_HOST is blank, emails are printed to the console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Campus Netra <no-reply@campusnetra.app>"
