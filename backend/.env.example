# ---------- Application ----------
APP_NAME="Campus Netra"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---------- Database ----------
# Local dev default matches scripts/dev_db.sh (port 55432, no password needed)
DATABASE_URL=postgresql+asyncpg://neondb_owner:----

# ---------- Security ----------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production-use-a-64-byte-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
OTP_EXPIRE_MINUTES=10
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ---------- AI ----------
# Leave every key below blank to run on the deterministic heuristic
# fallback (no API calls, still works, just less accurate).
AI_ENABLED=true

# Free-only multi-provider router (app/ai/router.py) -- the default and
# recommended mode. Every key below is optional; the router simply has
# fewer providers to fail over across with fewer configured. It never
# selects a paid model, and never uses Anthropic (no genuine free API
# tier for that one). Set to false to use the single legacy AI_PROVIDER/
# AI_MODEL path further down instead (including Anthropic, if you
# actually want to pay for it).
AI_FREE_ONLY=true

# OpenRouter: real dynamic free-model discovery -- verified against its
# own live pricing data on every refresh, not a fixed model list.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Gemini (Google AI Studio): free-tier by construction for an AI Studio
# key (not a Vertex/billing-enabled one). https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Comma-separated allowlist -- Gemini doesn't expose per-model pricing the
# way OpenRouter does, so this stays an explicit, conservative list rather
# than an assumption that every model the key can reach is free.
GEMINI_MODELS=gemini-2.0-flash,gemini-1.5-flash,gemini-1.5-flash-8b

# Groq: free public API. https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant,gemma2-9b-it

# ---------- AI: legacy single-provider path (AI_FREE_ONLY=false only) ----------
AI_PROVIDER=openrouter
AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Only used if AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# ---------- Storage ----------
# 'local' writes to ./uploads and serves them from /media. Fine for local
# dev; on most PaaS hosts (Render included) the disk is wiped on every
# redeploy or restart, silently deleting every photo. Use 'local' only if
# your host gives you a persistent volume. Set 's3' to point at any
# S3-compatible bucket instead — AWS S3, Cloudflare R2, Backblaze B2, and
# DigitalOcean Spaces all work; R2 and B2 both have workable free tiers.
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Only used when STORAGE_BACKEND=s3. Leave all blank for local storage.
# S3_BUCKET / S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY are required once s3
# is selected — the app refuses to start without them.
S3_BUCKET=
# AWS: your bucket's region, e.g. us-east-1. R2/B2/Spaces: leave "auto" or
# check the provider's docs.
S3_REGION=auto
# Leave blank for plain AWS S3. Required for R2/B2/Spaces, e.g.:
#   Cloudflare R2:      https://<account-id>.r2.cloudflarestorage.com
#   Backblaze B2:        https://s3.<region>.backblazeb2.com
#   DigitalOcean Spaces:  https://<region>.digitaloceanspaces.com
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Where uploaded photos are served from publicly. Leave blank to fall back
# to a default the bucket will answer directly (works, but a CDN/custom
# domain in front of the bucket is faster) — e.g.:
#   Plain AWS S3 default: https://<bucket>.s3.<region>.amazonaws.com
#   Behind a CDN/custom domain: https://media.yourcampus.edu
S3_PUBLIC_BASE_URL=
#
# Objects are written with no per-object ACL (buckets created on AWS since
# April 2023 have ACLs disabled by default, and several S3-compatible
# providers never supported them). Public read access for uploaded photos
# comes from a bucket policy instead — apply one covering only the
# "public/" prefix, e.g. for AWS S3:
#   {
#     "Version": "2012-10-17",
#     "Statement": [{
#       "Sid": "PublicReadUploads",
#       "Effect": "Allow",
#       "Principal": "*",
#       "Action": "s3:GetObject",
#       "Resource": "arn:aws:s3:::YOUR_BUCKET_NAME/public/*"
#     }]
#   }
# The "private/" prefix (ID cards, etc.) is never covered by this policy —
# it's only ever read through the backend's authenticated routes.

# ---------- Email (OTP / password reset) ----------
# When SMTP_HOST is blank, emails are printed to the console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Campus Netra <no-reply@campusnetra.app>"

# HTTP-API alternatives to SMTP — most PaaS free tiers block outbound SMTP
# ports, so these are what actually work once deployed. Set either or both;
# see EMAIL_AND_SMS_SETUP.md at the repo root for full setup steps
# (domain verification, sandbox limits, etc.) for each provider below.
RESEND_API_KEY=
BREVO_API_KEY=

# Which transport each kind of OTP uses. Leave all three as "auto" for a
# single-provider setup (whichever of RESEND_API_KEY/BREVO_API_KEY/SMTP_HOST
# is set gets used for everything). Pin specific ones if you run two
# providers side by side — e.g. Brevo for sign-up/reset (which email your
# own registered users) and Resend for the profile email-change flow
# (which emails an address that isn't a user yet):
#   EMAIL_PROVIDER_EMAIL_VERIFY=brevo
#   EMAIL_PROVIDER_PASSWORD_RESET=brevo
#   EMAIL_PROVIDER_EMAIL_CHANGE=resend
# A pin naming a provider with no key set falls back to "auto" rather than
# failing every send. Accepted values: auto, resend, brevo, smtp.
# Defaults to "brevo" for all three — override per-purpose if you split
# providers as described above.
EMAIL_PROVIDER_EMAIL_VERIFY=brevo
EMAIL_PROVIDER_PASSWORD_RESET=brevo
EMAIL_PROVIDER_EMAIL_CHANGE=brevo

# ---------- SMS (phone-change OTP, phone-based password reset) ----------
# Two providers are wired in: Brevo (default) and Twilio. Leave
# SMS_PROVIDER=none to have codes logged to the console instead of texted
# (same fallback as email). See EMAIL_AND_SMS_SETUP.md for the full setup
# steps for either — and, if you're sending to Indian numbers, for why an
# API call can report success while nothing ever reaches the phone (DLT/TRAI
# sender registration, not a credentials problem — read that section before
# assuming the code is broken).
SMS_PROVIDER=brevo

# --- Brevo SMS (used when SMS_PROVIDER=brevo) ---
# Same BREVO_API_KEY as the email section above works here too — Brevo SMS
# credits are purchased separately from email credits in their dashboard.
BREVO_SMS_SENDER=CampusNetra

# --- Twilio (used when SMS_PROVIDER=twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Must be a number Twilio gave you (bought, or your trial number), in E.164
# form — e.g. "+15017122661". Not a personal phone number.
TWILIO_FROM_NUMBER=

# Phone numbers are stored as a bare 10-digit local number, so this is
# prepended to build the E.164 address either provider requires. Change it
# if your users are outside India.
SMS_DEFAULT_COUNTRY_CODE=+91

# ---------- IoT: MQTT (HiveMQ Cloud) ----------
# Points this backend at the already-existing ESP32 -> HiveMQ Cloud fleet.
# Leave MQTT_BROKER_HOST blank to disable the bridge (telemetry then only
# arrives via the authenticated HTTP POST /iot/telemetry path).
MQTT_BROKER_HOST=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.s1.eu.hivemq.cloud
MQTT_BROKER_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=

# ---------- IoT: InfluxDB Cloud (raw telemetry history) ----------
# Neon/Postgres stays the source of truth for current state; this is
# write-only raw history. Leave INFLUXDB_URL blank to disable.
INFLUXDB_URL=https://us-east-1-1.aws.cloud2.influxdata.com
INFLUXDB_TOKEN=
INFLUXDB_ORG=CampusNetra
INFLUXDB_BUCKET=campusnetra_telemetry
INFLUXDB_MEASUREMENT=room_telemetry

# A device shows OFFLINE on the Health page once its last telemetry is
# older than this many minutes.
IOT_DEVICE_OFFLINE_MINUTES=3
